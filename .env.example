# Copy to .env and fill in. Never commit .env.

# Neon.tech / Supabase connection string (any postgres:// or postgresql:// form works)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Upstash Redis (use the rediss:// URL) or redis://localhost:6379/0
REDIS_URL=rediss://default:password@xxxx.upstash.io:6379

# Free Groq key (https://console.groq.com) or a Google Gemini key
LLM_API_KEY=
LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile

JWT_SECRET=replace-with-a-long-random-string

# Where the gateway reaches the ledger, and which browser origins may call the gateway
LEDGER_URL=http://localhost:8002
ALLOWED_ORIGINS=http://localhost:3000
